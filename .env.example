# Application / infrastructure secrets
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-at-least-50-characters
DJANGO_DEBUG=true
# Local HTTP only. Set both to true behind HTTPS in production.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
SECURE_SSL_REDIRECT=false
POSTGRES_PASSWORD=replace-this-with-a-long-random-password
TOKEN_ENCRYPTION_KEY=

# Compose builds DATABASE_URL from POSTGRES_PASSWORD; do not set DATABASE_URL here.
# DATABASE_SSL_REQUIRE is forced to false by compose.yaml for local PostgreSQL.

# Developer OAuth application credentials (never user access tokens)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback/

VK_ID_CLIENT_ID=
VK_ID_REDIRECT_URI=http://127.0.0.1:8000/vk/callback/
# Optional server-side VK ID service token for confidential applications
VK_ID_SERVICE_TOKEN=
VK_API_VERSION=5.289

CELERY_BROKER_URL=redis://redis:6379/0
